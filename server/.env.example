# Copia questo file in ".env" e adatta i valori. Il file .env non va mai su git.
# I percorsi sono relativi alla cartella server/.

# Porta su cui il server ascolta (gli altri PC apriranno http://nome-pc:PORT)
PORT=3000

# File del database SQLite (un solo file: per il backup basta copiarlo)
DATABASE_URL="file:./data/gestionale.db"

# Cartella dove vengono salvati i documenti caricati (non raggiungibile dal browser)
UPLOAD_DIR=./uploads

# Durata di una sessione di login, in ore (si rinnova mentre l'utente lavora)
SESSION_HOURS=12

# Metti "true" solo se il gestionale è servito in HTTPS
COOKIE_SECURE=false
